{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "plays": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string"
          },
          "shortTitle": {
            "type": "string"
          },
          "genre": {
            "type": "string",
            "enum": [
              "comedy",
              "tragedy",
              "history",
              "romance",
              "problem"
            ]
          },
          "composed": {
            "type": "object",
            "properties": {
              "from": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "to": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "from",
              "to"
            ],
            "additionalProperties": false
          },
          "modernVersionId": {
            "type": "string",
            "minLength": 1
          },
          "versions": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "name": {
                  "type": "string"
                },
                "shortName": {
                  "type": "string"
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "modern",
                    "original"
                  ]
                },
                "printed": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "sourceIds": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "required": [
                "id",
                "name",
                "shortName",
                "kind",
                "sourceIds"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "title",
          "shortTitle",
          "genre",
          "composed",
          "modernVersionId",
          "versions"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "plays"
  ],
  "additionalProperties": false
}
