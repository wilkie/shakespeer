{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "playId": {
      "type": "string",
      "minLength": 1
    },
    "variants": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "note": {
            "type": "string"
          },
          "sourceIds": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "readings": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "versionId": {
                  "type": "string",
                  "minLength": 1
                },
                "start": {
                  "type": "object",
                  "properties": {
                    "nodeId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "offset": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "nodeId",
                    "offset"
                  ],
                  "additionalProperties": false
                },
                "end": {
                  "type": "object",
                  "properties": {
                    "nodeId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "offset": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "nodeId",
                    "offset"
                  ],
                  "additionalProperties": false
                },
                "text": {
                  "type": "string"
                }
              },
              "required": [
                "versionId",
                "text"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "title",
          "note",
          "sourceIds",
          "readings"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "playId",
    "variants"
  ],
  "additionalProperties": false
}
